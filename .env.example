# Copia este archivo a .env y reemplaza los marcadores. .env está ignorado por git.
# La contraseña debe cumplir la política de SQL Server (mínimo 8 caracteres con
# mayúsculas, minúsculas, dígitos y símbolos) y no contener ";", "=" ni comillas.
BHH_SQL_SA_PASSWORD='__DEFINIR_CLAVE_LOCAL__'
ConnectionStrings__BlackHellHeim='Server=localhost,1433;Database=BlackHellHeim;User Id=sa;Password=__DEFINIR_CLAVE_LOCAL__;Encrypt=True;TrustServerCertificate=True'

# Puerto del host donde se publica el API del contenedor (opcional; por defecto 5068).
BHH_API_PUERTO='5068'

# Autenticación (historia 013). Clave de firma del JWT: aleatoria, mínimo 32 caracteres
# (por ejemplo, `openssl rand -base64 48`). Nunca la subas al repositorio.
BHH_JWT_CLAVE='__DEFINIR_CLAVE_JWT__'
# Administrador inicial (opcional): si ambos tienen valor, la API crea la cuenta al arrancar.
BHH_ADMIN_CORREO=''
BHH_ADMIN_CONTRASENA=''

# Printful (historia 015, opcional): token privado de la tienda; sin él el catálogo de Printful responde 502.
# BHH_PRINTFUL_TOKEN=

# Almacén de arte (historia 017, opcional). Sin valor, el compose usa su Azurite local (clave pública de desarrollo
# incorporada en el SDK). Para la API fuera de Docker: UseDevelopmentStorage=true. En producción va en los secretos de Azure.
# BHH_ALMACEN_CADENA=

# Banxico (historia 020, opcional): token gratuito de la API SIE; sin él el tipo de cambio no se actualiza.
# BHH_BANXICO_TOKEN=
